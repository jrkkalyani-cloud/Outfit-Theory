<script>
  (function initAtelierCustomStudio() {
    // Current Configuration State
    const atelierState = {
      silhouette: 'hoodie',
      silhouetteName: 'Oversized Hoodie 420 GSM',
      basePrice: 3999,
      color: 'Obsidian Black',
      colorHex: '#131313',
      size: 'M',
      view: 'front',
      scale: 68,
      rotation: 0,
      placements: {
        'front-center': true,
        'left-chest': false,
        'full-back': false,
        'sleeve': false
      },
      placementCosts: {
        'front-center': 0,
        'left-chest': 250,
        'full-back': 450,
        'sleeve': 200
      },
      technique: 'dtg',
      techniqueName: 'High-Def DTG',
      techniqueCost: 0,
      notes: ''
    };

    // DOM Elements
    const garmentImgFront = document.getElementById('garmentImgFront');
    const garmentImgBack = document.getElementById('garmentImgBack');
    const colorCastLayer = document.getElementById('colorCastLayer');
    const viewFrontBtn = document.getElementById('viewFrontBtn');
    const viewBackBtn = document.getElementById('viewBackBtn');
    const currentColorLabel = document.getElementById('currentColorLabel');
    const scaleSlider = document.getElementById('scaleSlider');
    const rotateSlider = document.getElementById('rotateSlider');
    const scaleValueLabel = document.getElementById('scaleValueLabel');
    const rotateValueLabel = document.getElementById('rotateValueLabel');
    const artworkElement = document.getElementById('artworkElement');
    const resetTransformBtn = document.getElementById('resetTransformBtn');

    const specGsm = document.getElementById('specGsm');
    const specSilhouette = document.getElementById('specSilhouette');
    const specPrintTech = document.getElementById('specPrintTech');

    const summarySilhouette = document.getElementById('summarySilhouette');
    const summaryTech = document.getElementById('summaryTech');
    const priceBase = document.getElementById('priceBase');
    const pricePlacements = document.getElementById('pricePlacements');
    const priceTechnique = document.getElementById('priceTechnique');
    const totalPrice = document.getElementById('totalPrice');
    const whatsAppConciergeBtn = document.getElementById('whatsAppConciergeBtn');

    const dropZone = document.getElementById('dropZone');
    const artworkFileInput = document.getElementById('artworkFileInput');
    const uploadedGraphicPreview = document.getElementById('uploadedGraphicPreview');
    const uploadedFileName = document.getElementById('uploadedFileName');
    const replaceFileBtn = document.getElementById('replaceFileBtn');

    const silhouetteBtns = document.querySelectorAll('.silhouette-btn');
    const colorBtns = document.querySelectorAll('.color-swatch-btn');
    const sizeBtns = document.querySelectorAll('.size-btn');
    const techBtns = document.querySelectorAll('.tech-btn');
    const placementCheckboxes = document.querySelectorAll('.placement-check');

    const addToBagBtn = document.getElementById('addToBagBtn');
    const buyNowBtn = document.getElementById('buyNowBtn');
    const atelierToast = document.getElementById('atelierToast');
    const toastMessage = document.getElementById('toastMessage');

    // Silhouette Swapping
    silhouetteBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        silhouetteBtns.forEach(b => {
          b.classList.remove('bg-surface-container-high');
          b.classList.add('bg-surface-container-low');
        });
        btn.classList.remove('bg-surface-container-low');
        btn.classList.add('bg-surface-container-high');

        atelierState.silhouette = btn.getAttribute('data-silhouette');
        atelierState.basePrice = parseInt(btn.getAttribute('data-price'), 10);
        atelierState.silhouetteName = btn.querySelector('.font-title-md').innerText;
        
        specGsm.innerText = btn.getAttribute('data-gsm');
        specSilhouette.innerText = btn.getAttribute('data-fit');
        summarySilhouette.innerText = atelierState.silhouetteName;

        updateCalculation();
      });
    });

    // Front/Back Toggle
    function setView(view) {
      atelierState.view = view;
      if (view === 'front') {
        garmentImgFront.classList.remove('opacity-0', 'pointer-events-none');
        garmentImgFront.classList.add('opacity-100');
        garmentImgBack.classList.add('opacity-0', 'pointer-events-none');
        garmentImgBack.classList.remove('opacity-100');

        viewFrontBtn.classList.add('bg-primary', 'text-on-primary');
        viewFrontBtn.classList.remove('text-outline');
        viewBackBtn.classList.remove('bg-primary', 'text-on-primary');
        viewBackBtn.classList.add('text-outline');
      } else {
        garmentImgBack.classList.remove('opacity-0', 'pointer-events-none');
        garmentImgBack.classList.add('opacity-100');
        garmentImgFront.classList.add('opacity-0', 'pointer-events-none');
        garmentImgFront.classList.remove('opacity-100');

        viewBackBtn.classList.add('bg-primary', 'text-on-primary');
        viewBackBtn.classList.remove('text-outline');
        viewFrontBtn.classList.remove('bg-primary', 'text-on-primary');
        viewFrontBtn.classList.add('text-outline');
      }
    }

    viewFrontBtn.addEventListener('click', () => setView('front'));
    viewBackBtn.addEventListener('click', () => setView('back'));

    // Dynamic Color Switching
    colorBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        colorBtns.forEach(b => b.classList.remove('ring-2', 'ring-primary', 'scale-105'));
        btn.classList.add('ring-2', 'ring-primary', 'scale-105');

        atelierState.color = btn.getAttribute('data-color');
        atelierState.colorHex = btn.getAttribute('data-hex');
        currentColorLabel.innerText = atelierState.color;

        // Apply visual shade cast
        if (atelierState.color === 'Obsidian Black') {
          colorCastLayer.style.backgroundColor = 'transparent';
        } else if (atelierState.color === 'Off-White Ivory') {
          colorCastLayer.style.backgroundColor = 'rgba(236, 235, 231, 0.45)';
        } else if (atelierState.color === 'Forest Emerald') {
          colorCastLayer.style.backgroundColor = 'rgba(28, 46, 36, 0.55)';
        } else if (atelierState.color === 'Silver Fog') {
          colorCastLayer.style.backgroundColor = 'rgba(142, 147, 155, 0.45)';
        } else {
          colorCastLayer.style.backgroundColor = 'rgba(46, 46, 49, 0.5)';
        }

        updateWhatsAppMessage();
      });
    });

    // Size Selection
    sizeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        sizeBtns.forEach(b => {
          b.classList.remove('bg-surface-container-high', 'text-primary', 'ring-1', 'ring-primary');
          b.classList.add('bg-surface-container-low', 'text-outline');
        });
        btn.classList.remove('bg-surface-container-low', 'text-outline');
        btn.classList.add('bg-surface-container-high', 'text-primary', 'ring-1', 'ring-primary');

        atelierState.size = btn.getAttribute('data-size');
        updateWhatsAppMessage();
      });
    });

    // Technique Selection
    techBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        techBtns.forEach(b => {
          b.classList.remove('bg-surface-container-high');
          b.classList.add('bg-surface-container-low');
        });
        btn.classList.remove('bg-surface-container-low');
        btn.classList.add('bg-surface-container-high');

        atelierState.technique = btn.getAttribute('data-tech');
        atelierState.techniqueCost = parseInt(btn.getAttribute('data-cost'), 10);
        atelierState.techniqueName = btn.querySelector('.font-title-md').innerText;
        summaryTech.innerText = atelierState.techniqueName;
        specPrintTech.innerText = atelierState.techniqueName.toUpperCase();

        updateCalculation();
      });
    });

    // Placement Checkbox handling
    placementCheckboxes.forEach(chk => {
      chk.addEventListener('change', () => {
        const placement = chk.getAttribute('data-placement');
        atelierState.placements[placement] = chk.checked;
        updateCalculation();
      });
    });

    // Artwork Transform Engine
    function applyTransform() {
      const scaleDecimal = atelierState.scale / 100;
      artworkElement.style.transform = `scale(${scaleDecimal}) rotate(${atelierState.rotation}deg)`;
      scaleValueLabel.innerText = `${atelierState.scale}%`;
      rotateValueLabel.innerText = `${atelierState.rotation}°`;
    }

    scaleSlider.addEventListener('input', (e) => {
      atelierState.scale = parseInt(e.target.value, 10);
      applyTransform();
    });

    rotateSlider.addEventListener('input', (e) => {
      atelierState.rotation = parseInt(e.target.value, 10);
      applyTransform();
    });

    resetTransformBtn.addEventListener('click', () => {
      atelierState.scale = 68;
      atelierState.rotation = 0;
      scaleSlider.value = 68;
      rotateSlider.value = 0;
      applyTransform();
    });

    // Drag-and-Drop / File Upload
    dropZone.addEventListener('click', () => artworkFileInput.click());
    replaceFileBtn.addEventListener('click', () => artworkFileInput.click());

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('bg-surface-container-high');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('bg-surface-container-high');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('bg-surface-container-high');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleFileSelect(e.dataTransfer.files[0]);
      }
    });

    artworkFileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        handleFileSelect(e.target.files[0]);
      }
    });

    function handleFileSelect(file) {
      uploadedFileName.innerText = file.name.toUpperCase();
      const reader = new FileReader();
      reader.onload = (event) => {
        uploadedGraphicPreview.src = event.target.result;
        showToast('Artwork Vector Ingested Successfully');
      };
      reader.readAsDataURL(file);
    }

    // Dynamic Cost Engine
    function updateCalculation() {
      let placementsSum = 0;
      Object.keys(atelierState.placements).forEach(key => {
        if (atelierState.placements[key]) {
          placementsSum += atelierState.placementCosts[key];
        }
      });

      const total = atelierState.basePrice + placementsSum + atelierState.techniqueCost;

      priceBase.innerText = `₹${atelierState.basePrice.toLocaleString('en-IN')}`;
      pricePlacements.innerText = `+₹${placementsSum.toLocaleString('en-IN')}`;
      priceTechnique.innerText = `+₹${atelierState.techniqueCost.toLocaleString('en-IN')}`;
      totalPrice.innerText = `₹${total.toLocaleString('en-IN')}`;

      updateWhatsAppMessage();
    }

    function updateWhatsAppMessage() {
      const activePlacements = Object.keys(atelierState.placements)
        .filter(k => atelierState.placements[k])
        .join(', ');

      const message = `Hello Outfit Theory Atelier, I have configured custom garment specifications:\n- Silhouette: ${atelierState.silhouetteName}\n- Color: ${atelierState.color}\n- Size: ${atelierState.size}\n- Technique: ${atelierState.techniqueName}\n- Artwork Placements: ${activePlacements}\n- Total: ${totalPrice.innerText}\nPlease consult me on production lead time.`;

      whatsAppConciergeBtn.href = `https://wa.me/919611623514?text=${encodeURIComponent(message)}`;
    }

    // Toast Notifications
    function showToast(text) {
      toastMessage.innerText = text;
      atelierToast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
      setTimeout(() => {
        atelierToast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
      }, 3500);
    }

    addToBagBtn.addEventListener('click', () => {
      showToast('Custom Piece Added To Bag');
    });

    buyNowBtn.addEventListener('click', () => {
      showToast('Redirecting To Atelier Direct Checkout...');
    });

    // Initialize initial calculations
    updateCalculation();
  })();
